{
  "name": "claude-stats-statusbar",
  "displayName": "ClaudeStats",
  "description": "See your Claude Code plan usage in the status bar: session and weekly limits at a glance, with every window and its reset time on hover.",
  "version": "0.2.0",
  "publisher": "awmium",
  "author": {
    "name": "Azmir Murad"
  },
  "license": "MIT",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#141311",
    "theme": "dark"
  },
  "pricing": "Free",
  "qna": "https://github.com/awmium/claude-stats/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/awmium/claude-stats.git"
  },
  "bugs": {
    "url": "https://github.com/awmium/claude-stats/issues"
  },
  "homepage": "https://github.com/awmium/claude-stats#readme",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=20"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "claude",
    "claude code",
    "usage",
    "status bar",
    "rate limit"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "scripts": {
    "test": "node --test test/statusline-usage.test.js test/extension.test.js test/setup.test.js test/onboarding.test.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "claudeStats.refresh",
        "title": "ClaudeStats: Refresh Now"
      },
      {
        "command": "claudeStats.setup",
        "title": "ClaudeStats: Set Up Claude Code Hook"
      },
      {
        "command": "claudeStats.removeHook",
        "title": "ClaudeStats: Remove Claude Code Hook"
      }
    ],
    "configuration": {
      "title": "ClaudeStats",
      "properties": {
        "claudeStats.pollWhenStale": {
          "type": "boolean",
          "default": true,
          "description": "When no Claude Code session has reported recently, fetch usage directly from the Anthropic usage endpoint. Turn this off to keep the extension entirely offline."
        },
        "claudeStats.staleAfterMinutes": {
          "type": "number",
          "default": 10,
          "description": "Age at which the last session-reported figure is considered stale."
        }
      }
    }
  }
}
